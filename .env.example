# Basic application settings
APP_ENV=development
LOG_LEVEL=info

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS: allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM provider (Part 2)
# Supported providers: gemini
LLM_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey — keep it ONLY in .env
GEMINI_API_KEY=
# Model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tools (Part 3)
# Web search: get a key at https://tavily.com (free tier)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Weather uses Open-Meteo — no key needed

# Agent orchestration (Part 3)
# Hard cap on supervisor routing steps (prevents infinite delegation loops)
SUPERVISOR_MAX_STEPS=6
# Tool retry policy for transient failures (network, 429/5xx)
TOOL_MAX_RETRIES=2
TOOL_RETRY_DELAY_SECONDS=1.0

# Voice (Part 5)
# Speech-to-text: get a key at https://console.deepgram.com (free tier)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
# Text-to-speech: get a key at https://elevenlabs.io (free tier)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Voice id (default "Rachel"); browse at https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Google OAuth (Part 6)
# 1. Create OAuth credentials at https://console.cloud.google.com (type: Web application)
# 2. Add the redirect URI below to "Authorized redirect URIs"
# 3. Enable the Gmail API and Google Calendar API for the project
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Embeddings / RAG (Part 7)
# Uses the same GEMINI_API_KEY as the LLM layer
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
# Retrieval tuning: below this cosine similarity a chunk is "irrelevant"
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2
# Chunking
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
UPLOAD_MAX_MB=10

# PostgreSQL (Part 4; real schema via Alembic migrations)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=voiceops
POSTGRES_PASSWORD=voiceops_dev_password
POSTGRES_DB=voiceops

# Redis (rate-limit / cache backend; in-process limiter in dev)
REDIS_URL=redis://localhost:6379/0

# Authentication (Part 8)
# Signs the HS256 access tokens (JWTs). REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Access-token lifetime in minutes (default 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limiting (Part 8): requests per user per minute
CHAT_RATE_LIMIT_PER_MIN=30
VOICE_RATE_LIMIT_PER_MIN=15
UPLOAD_RATE_LIMIT_PER_MIN=10

# NEVER commit real keys. Put actual values in .env (gitignored) only.
# LEAST-PRIVILEGE SCOPES (requested during Google consent, see app/services/google_oauth.py):
#   gmail.readonly, gmail.compose, gmail.send, calendar.events, calendar.readonly
